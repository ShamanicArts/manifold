{
  "schemaVersion": 1,
  "id": "manifold.envelope-ducking-study",
  "name": "Envelope ducking",
  "source": "v2 authored study using legacy EnvelopeFollower detection as sample-rate CV",
  "signal": {
    "inputs": 2,
    "outputs": 2,
    "nodes": [
      { "id": 1, "type": "input.raw" },
      { "id": 2, "type": "envelope-control", "a": 10, "b": 120 },
      { "id": 3, "type": "modulated-gain", "a": 1, "b": -1.5 },
      { "id": 4, "type": "output" }
    ],
    "connections": [
      { "from": 1, "to": 2, "inputPort": 0 },
      { "from": 1, "to": 3, "inputPort": 0 },
      { "from": 2, "to": 3, "inputPort": 1 },
      { "from": 3, "to": 4, "inputPort": 0 }
    ],
    "initialParameters": [
      { "nodeId": 2, "id": 2, "value": 4 }
    ]
  },
  "parameters": [
    { "id": 0, "nodeId": 2, "nodeParameterId": 4, "hostId": "detector-mode", "label": "Detector", "kind": "choice", "choices": ["Peak", "RMS", "Hybrid"], "default": 0 },
    { "id": 1, "nodeId": 2, "nodeParameterId": 0, "hostId": "attack", "label": "Attack (ms)", "kind": "float", "min": 0.01, "max": 500, "default": 10 },
    { "id": 2, "nodeId": 2, "nodeParameterId": 1, "hostId": "release", "label": "Release (ms)", "kind": "float", "min": 0.1, "max": 5000, "default": 120 },
    { "id": 3, "nodeId": 2, "nodeParameterId": 2, "hostId": "sensitivity", "label": "Sensitivity", "kind": "float", "min": 0.01, "max": 16, "default": 4 },
    { "id": 4, "nodeId": 2, "nodeParameterId": 3, "hostId": "highpass", "label": "Highpass (Hz)", "kind": "float", "min": 5, "max": 4000, "default": 80 },
    { "id": 5, "nodeId": 3, "nodeParameterId": 0, "hostId": "base-gain", "label": "Base gain", "kind": "float", "min": 0, "max": 2, "default": 1, "effectiveMeter": true },
    { "id": 6, "nodeId": 3, "nodeParameterId": 1, "hostId": "duck-depth", "label": "Duck depth", "kind": "float", "min": -2, "max": 0, "default": -1.5 }
  ]
}
