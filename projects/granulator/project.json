{
  "schemaVersion": 1,
  "id": "manifold.granulator",
  "name": "Granulator",
  "source": "Legacy GranulatorNode capture ring",
  "signal": {
    "inputs": 2,
    "outputs": 2,
    "nodes": [
      { "id": 1, "type": "input.raw" },
      { "id": 2, "type": "granulator" },
      { "id": 3, "type": "output" }
    ],
    "connections": [
      { "from": 1, "to": 2, "inputPort": 0 },
      { "from": 2, "to": 3, "inputPort": 0 }
    ]
  },
  "parameters": [
    { "id": 0, "nodeId": 2, "nodeParameterId": 0, "hostId": "size", "label": "Grain size", "kind": "float", "min": 1, "max": 500, "default": 80, "unit": "ms" },
    { "id": 1, "nodeId": 2, "nodeParameterId": 1, "hostId": "density", "label": "Density", "kind": "float", "min": 1, "max": 100, "default": 20, "unit": "/s" },
    { "id": 2, "nodeId": 2, "nodeParameterId": 2, "hostId": "position", "label": "Capture position", "kind": "float", "min": 0, "max": 1, "default": 0.05 },
    { "id": 3, "nodeId": 2, "nodeParameterId": 3, "hostId": "pitch", "label": "Grain pitch", "kind": "float", "min": -24, "max": 24, "default": 0, "unit": "st" },
    { "id": 4, "nodeId": 2, "nodeParameterId": 4, "hostId": "spray", "label": "Spray", "kind": "float", "min": 0, "max": 1, "default": 0.2 },
    { "id": 5, "nodeId": 2, "nodeParameterId": 5, "hostId": "mix", "label": "Wet mix", "kind": "float", "min": 0, "max": 1, "default": 1 },
    { "id": 6, "nodeId": 2, "nodeParameterId": 6, "hostId": "freeze", "label": "Freeze capture", "kind": "toggle", "default": 0 },
    { "id": 7, "nodeId": 2, "nodeParameterId": 7, "hostId": "envelope", "label": "Grain envelope", "kind": "choice", "choices": ["Hann", "Triangle", "Blackman", "Tukey", "Rectangle"], "default": 0 },
    { "id": 8, "nodeId": 2, "nodeParameterId": 8, "hostId": "enabled", "label": "Granulator enabled", "kind": "toggle", "default": 1 }
  ]
}
