    {
      "id": 0,
      "nodeId": 2,
      "nodeParameterId": 0,
      "hostId": "frequency",
      "label": "Modulation frequency",
      "kind": "float",
      "unit": "Hz",
      "min": 0.1,
      "max": 8000,
      "default": 180
    },
    {
      "id": 1,
      "nodeId": 2,
      "nodeParameterId": 1,
      "hostId": "depth",
      "label": "Depth",
      "kind": "float",
      "min": 0,
      "max": 1,
      "default": 1
    },
    {
      "id": 2,
      "nodeId": 2,
      "nodeParameterId": 2,
      "hostId": "mix",
      "label": "Wet mix",
      "kind": "float",
      "min": 0,
      "max": 1,
      "default": 1
    },
    {
      "id": 3,
      "nodeId": 2,
      "nodeParameterId": 3,
      "hostId": "spread",
      "label": "Stereo spread",
