{
  "schemaVersion": 1,
  "id": "manifold.ring-modulator",
  "name": "Ring modulator",
  "source": "Legacy RingModulatorNode stereo scalar path",
  "signal": {
    "inputs": 2,
    "outputs": 2,
    "patchable": true,
    "nodes": [
      {
        "id": 1,
        "type": "input.raw"
      },
      {
        "id": 2,
        "type": "ring-modulator"
      },
      {
        "id": 3,
        "type": "output"
      }
